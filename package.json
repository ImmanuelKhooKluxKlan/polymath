{
  "name": "polymath-musician",
  "version": "3.1.0",
  "private": true,
  "type": "module",
  "description": "Polymath Musician: unified JSON/MIDI performance engine, studio piano tails, responsive visual instrument teaching, local optical music recognition, marketplace Mcoins, and PayPal subscriptions.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint src --ext js,jsx --report-unused-disable-directives --max-warnings 0",
    "align:notes": "node scripts/alignment/noteCoordinateAligner.mjs",
    "test:alignment": "node --test scripts/alignment/noteCoordinateAligner.test.mjs",
    "test:performance": "node --test scripts/performance/devicePerformance.test.mjs scripts/performance/learningCoach.test.mjs scripts/performance/learningMomentum.test.mjs scripts/performance/learningWin.test.mjs",
    "test:falling-notes": "node --test scripts/performance/fallingNoteGeometry.test.mjs",
    "test:teacher-hands": "node --test scripts/performance/teacherHands.test.mjs",
    "test:teacher-voice": "node --test scripts/performance/teacherVoice.test.mjs",
    "test:teacher-animation": "node --test scripts/performance/teacherSpeechAnimation.test.mjs",
    "qa:teacher-hands": "node scripts/qa/captureTeacherHands.mjs",
    "test:learning-coach": "node --test scripts/performance/learningCoach.test.mjs",
    "test:guitar-voicing": "node --test scripts/performance/guitarVoicing.test.mjs",
    "test:auth-phone": "node --test scripts/auth/phoneNumbers.test.mjs",
    "test:omr": "python -m unittest discover -s server/omr/tests -p test_*.py",
    "test:ml": "python -m unittest discover -s ml/training/tests -p test_*.py",
    "test:chatboss": "python -m unittest ml.chatboss.test_dataset ml.chatboss.test_evaluation -v",
    "test:training-tools": "node --test scripts/training/trainingTools.test.mjs",
    "review:alignment": "node scripts/training/reviewAlignmentWindows.mjs",
    "build:piano-target": "node scripts/training/buildPianoReductionTarget.mjs",
    "compose:training-dataset": "node scripts/training/composePreparedDataset.mjs",
    "compare:checkpoints": "node scripts/training/compareCandidateEvaluations.mjs",
    "export:evaluation-songs": "node scripts/training/exportEvaluationSongs.mjs",
    "test:training": "npm run test:alignment && npm run test:training-tools && npm run test:ml",
    "acquire:iowa-mf": "node scripts/acquireIowaMf.js --range=A0-C8",
    "acquire:iowa-88": "node scripts/acquireIowaMf.js --range=A0-C8",
    "acquire:iowa-song-range": "node scripts/acquireIowaMf.js --range=A1-C7",
    "server": "npm --prefix server start",
    "server:dev": "npm --prefix server run dev"
  },
  "dependencies": {
    "@tonejs/midi": "^2.0.28",
    "@vitejs/plugin-react": "6.0.2",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "three": "^0.185.1",
    "vite": "8.0.16"
  },
  "devDependencies": {
    "eslint": "9.39.4",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.2"
  }
}
