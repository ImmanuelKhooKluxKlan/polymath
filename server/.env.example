# Server
PORT=3000
APP_REGION=local
DATABASE_URL=
DATABASE_STATE_KEY=primary
DATABASE_SSL=true
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DATABASE_POOL_MAX=10

# Private user uploads and generated files. Leave bucket empty for local disk.
# AWS S3: set bucket + region and use the ECS task role (no access keys).
# Cloudflare R2: also set endpoint and the R2 access key pair.
ARTIFACT_S3_BUCKET=
ARTIFACT_S3_REGION=us-east-2
ARTIFACT_S3_ENDPOINT=
ARTIFACT_S3_ACCESS_KEY_ID=
ARTIFACT_S3_SECRET_ACCESS_KEY=
ARTIFACT_S3_SSE=AES256
# Enables short-lived, user-bound browser-to-object-storage upload tickets.
# Generate a random value of at least 32 characters; never commit the real value.
DIRECT_UPLOAD_SIGNING_SECRET=
DIRECT_UPLOAD_TTL_SECONDS=900
DIRECT_UPLOAD_MAX_BYTES=5368709120

# Optional shared background queue. Leave empty for single-server local processing.
JOB_QUEUE_URL=
JOB_QUEUE_REGION=us-east-2
CLIENT_ORIGIN=http://localhost:5173
# Comma-separated additional trusted frontends, such as a Cloudflare Pages preview origin.
CLIENT_ORIGINS=
ADMIN_EMAILS=admin@polymath.local
# Optional one-time bootstrap password. It must contain at least 12 characters.
# Missing admin accounts are created at startup and must change this password at first login.
# Existing accounts are never reset. Remove this value after the admin account is created.
ADMIN_PASSWORD=
WELCOME_MCOINS=0

# Registration verification. Never commit real secret values.
# Generate REGISTRATION_OTP_SECRET as a random value of at least 32 characters.
REGISTRATION_OTP_SECRET=
REGISTRATION_OTP_TTL_MINUTES=10
REGISTRATION_OTP_RESEND_SECONDS=60
REGISTRATION_OTP_HOURLY_LIMIT=5
OTP_AWS_REGION=us-east-2
# Optional: omit these locally when using AWS CLI login/default credentials.
# A production host still needs a least-privilege AWS credential source.
OTP_AWS_ACCESS_KEY_ID=
OTP_AWS_SECRET_ACCESS_KEY=
# Optional for temporary AWS credentials.
OTP_AWS_SESSION_TOKEN=
# SES requires a verified sender identity.
OTP_EMAIL_FROM=
# Keep false until SNS SMS is configured and approved for production delivery.
OTP_SMS_ENABLED=false

# PayPal only. Use sandbox while developing.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_SECRET_KEY=
# Individual subscription plans.
PAYPAL_CHILL_MONTHLY_PLAN_ID=
PAYPAL_CHILL_YEARLY_PLAN_ID=
PAYPAL_MUSICIAN_MONTHLY_PLAN_ID=
PAYPAL_MUSICIAN_YEARLY_PLAN_ID=
# Institution subscription plans (30, 300, and 1,000 student seats).
PAYPAL_INSTITUTION_CLASS_MONTHLY_PLAN_ID=
PAYPAL_INSTITUTION_CLASS_YEARLY_PLAN_ID=
PAYPAL_INSTITUTION_COHORT_MONTHLY_PLAN_ID=
PAYPAL_INSTITUTION_COHORT_YEARLY_PLAN_ID=
PAYPAL_INSTITUTION_SCHOOL_MONTHLY_PLAN_ID=
PAYPAL_INSTITUTION_SCHOOL_YEARLY_PLAN_ID=
# Upgrade plans: setup fee is the price difference, followed by one free
# month/year before regular Musician billing. This resets the billing period.
PAYPAL_CHILL_TO_MUSICIAN_MONTHLY_PLAN_ID=
PAYPAL_CHILL_TO_MUSICIAN_YEARLY_PLAN_ID=
# Legacy fallback for existing Pro subscriptions.
PAYPAL_PRO_PLAN_ID=
PAYPAL_WEBHOOK_ID=

# Optional integrations
YOUTUBE_API_KEY=

# Provider-free PDF optical music recognition. Python packages are installed
# from server/omr/requirements.txt by Dockerfile.api.
OMR_ENABLED=true
OMR_PYTHON_BIN=python3
OMR_RENDER_DPI=300
OMR_MAX_PAGES=20
OMR_TIMEOUT_MS=1500000

# MuScriptor audio/video transcription. The published model weights are
# CC BY-NC 4.0 (non-commercial). Leave disabled unless your use is permitted.
MUSCRIPTOR_ENABLED=false
# Keep enabled transcription restricted to administrator accounts during testing.
MUSCRIPTOR_ADMIN_ONLY=true
MUSCRIPTOR_MODEL=large
MUSCRIPTOR_INFERENCE_VERSION=original
# Large can be much slower than real time on CPU-only servers.
MUSCRIPTOR_TIMEOUT_MINUTES=360
# Optional remote MuScriptor HTTP service, such as a private RunPod SSH tunnel.
# When set, this takes precedence over MUSCRIPTOR_PYTHON and MUSCRIPTOR_WORKER.
MUSCRIPTOR_REMOTE_URL=
MUSCRIPTOR_REMOTE_TOKEN=
# Permanent RunPod Serverless Flex endpoint. When complete, this takes
# precedence over the temporary MUSCRIPTOR_REMOTE_URL SSH tunnel.
RUNPOD_SERVERLESS_ENDPOINT_ID=
RUNPOD_API_KEY=
# Virtual teacher and customer-support conversation provider. Qwen/ChatBoss is
# not used by this path when this is set to deepseek.
POLYMATH_ASSISTANT_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_TIMEOUT_MS=45000
# ChatBoss is a separate OpenAI-compatible RunPod Serverless vLLM endpoint.
# It remains an administrator-only side project and is not the virtual teacher.
RUNPOD_CHAT_BOSS_ENDPOINT_ID=
RUNPOD_CHAT_BOSS_TEMPLATE_ID=
RUNPOD_CHAT_BOSS_NETWORK_VOLUME_ID=
RUNPOD_CHAT_BOSS_MODEL=polymath-chat-boss
RUNPOD_CHAT_BOSS_TIMEOUT_MS=900000
# Minimum pause between one user's Help requests. The daily maximum is enforced in code.
SUPPORT_REQUEST_INTERVAL_MS=1400
RUNPOD_CHAT_BOSS_S3_REGION=US-KS-2
RUNPOD_CHAT_BOSS_S3_ENDPOINT=https://s3api-us-ks-2.runpod.io/
# Optional JSON array of same-account ChatBoss volumes in other data centres.
RUNPOD_CHAT_BOSS_S3_REPLICAS=[]
# The attached RunPod network volume and its separate S3 API credentials.
RUNPOD_NETWORK_VOLUME_ID=
RUNPOD_S3_REGION=US-KS-2
RUNPOD_S3_ENDPOINT=https://s3api-us-ks-2.runpod.io
RUNPOD_S3_ACCESS_KEY_ID=
RUNPOD_S3_SECRET_ACCESS_KEY=
# Optional JSON array of failover volumes. Every job is copied to each volume
# before submission so RunPod can safely schedule a worker in any listed region.
# Example: [{"volumeId":"volume-id","region":"EU-RO-1","s3Endpoint":"https://s3api-eu-ro-1.runpod.io"}]
RUNPOD_S3_REPLICAS=[]
# Set true only when the admin Model Lab must be restricted to the server itself.
# Authentication and administrator authorization still apply when this is false.
MODEL_LAB_LOCAL_ONLY=false
MODEL_LAB_MAX_SECONDS=600
MODEL_LAB_TIMEOUT_MS=7200000
# Optional model-bootstrap settings. v001 is used when omitted.
MUSCRIPTOR_TEST_VERSION=v001
MUSCRIPTOR_LOCAL_MODEL_DIR=
# Windows example: C:\Users\your-name\muscriptor-eval-env\Scripts\python.exe
MUSCRIPTOR_PYTHON=
# Optional overrides; bundled FFmpeg and server/muscriptor_worker.py are defaults.
FFMPEG_PATH=
MUSCRIPTOR_WORKER=
# Optional final acoustic-piano arranger overrides. By default it reuses
# MUSCRIPTOR_PYTHON and server/piano_arranger.py for local and RunPod jobs.
PIANO_ARRANGER_PYTHON=
PIANO_ARRANGER_WORKER=
